# Conexion a Postgres (Supabase) --------------------------------------------
DB_PASSWORD="your_db_password_here"

# Pooler en modo transaccion (IPv4). Lo usa la aplicacion en runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler en modo sesion. Lo usa el CLI de Prisma para migraciones.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Autenticacion (GU-01 / GU-02) ---------------------------------------------
# Generar cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="genera_uno_propio_de_48_bytes"
REFRESH_TOKEN_PEPPER="genera_otro_distinto_de_48_bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="parchemos-api"
JWT_AUDIENCE="parchemos-app"

# Politica de bloqueo por intentos fallidos (GU-02 Esc. 4)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Costo del hash de contrasena (Argon2id)
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=4

# Servidor
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
