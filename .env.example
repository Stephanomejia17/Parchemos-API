# Conexión a Postgres (Supabase)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Autenticación
JWT_ACCESS_SECRET="genera_uno_propio_de_48_bytes"
REFRESH_TOKEN_PEPPER="genera_otro_distinto_de_48_bytes"
PASSWORD_RESET_TOKEN_PEPPER="genera_un_tercer_secret_de_48_bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="parchemos-api"
JWT_AUDIENCE="parchemos-app"

# Brevo
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="no-reply@tu-dominio-verificado.com"
BREVO_SENDER_NAME="Parchemos"

# Ruta del frontend que recibirá ?token=...
PASSWORD_RESET_URL="http://localhost:3000/reset-password"
PASSWORD_RESET_TTL="30m"

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=4
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
