// Esquema de datos de Parchemos.
// Alcance actual: GU-01 (Registro) y GU-02 (Inicio y cierre de sesion).
// Las reglas que Prisma no modela (CHECKs, triggers, RLS) viven en
// prisma/migrations/20260825000000_init_auth_gu01_gu02/migration.sql

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS compila a CommonJS: sin esto el cliente generado usa import.meta.url
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Roles de la plataforma. GU-01 solo permite auto-registro de COMENSAL y
/// RESTAURANTE; los demas se crean desde GU-05 / GU-06.
enum UserRole {
  comensal
  restaurante
  personal_restaurante
  repartidor
  administrador

  @@map("user_role")
}

/// Estado de la cuenta:
/// - pendiente_aprobacion: restaurante recien registrado (GU-01 Esc. 2)
/// - activa: puede iniciar sesion (GU-02 Esc. 1)
/// - suspendida: bloqueada por un administrador, con motivo (GU-02 Esc. 3)
/// - deshabilitada: acceso revocado
enum AccountStatus {
  pendiente_aprobacion
  activa
  suspendida
  deshabilitada

  @@map("account_status")
}

/// Motivo por el que un refresh token deja de ser valido (GU-02 Esc. 5 y 6).
enum SessionRevokeReason {
  logout
  logout_all
  rotacion
  expiracion
  cambio_password
  cuenta_suspendida
  revocada_por_admin

  @@map("session_revoke_reason")
}

/// Cuenta de acceso a la plataforma (GU-01).
model User {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Correo unico en toda la plataforma, case-insensitive (GU-01 Esc. 3).
  email               String        @unique @db.Citext
  /// Hash Argon2id/bcrypt. Nunca la contrasena en texto plano.
  passwordHash        String        @map("password_hash")
  passwordUpdatedAt   DateTime      @default(now()) @map("password_updated_at") @db.Timestamptz(6)

  fullName            String        @map("full_name")
  phone               String?

  role                UserRole
  status              AccountStatus @default(activa)
  /// Obligatorio cuando status = suspendida (GU-02 Esc. 3).
  suspensionReason    String?       @map("suspension_reason")
  statusChangedAt     DateTime      @default(now()) @map("status_changed_at") @db.Timestamptz(6)

  /// Aceptacion de terminos y politica de datos (GU-01 Esc. 6).
  termsAcceptedAt     DateTime      @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion        String        @default("1.0") @map("terms_version")
  privacyAcceptedAt   DateTime      @map("privacy_accepted_at") @db.Timestamptz(6)

  /// Bloqueo temporal por intentos fallidos (GU-02 Esc. 4).
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?     @map("last_login_at") @db.Timestamptz(6)

  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  loginAttempts       LoginAttempt[]
  restaurants         Restaurant[]
  /// Solo se usa cuando role = personal_restaurante (GU-05).
  staffLocationId     String?       @map("sede_id") @db.Uuid
  staffLocation       Location?     @relation("LocationStaff", fields: [staffLocationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([role])
  @@map("users")
}

/// Empresa propietaria de una o varias sedes. AN-01 permite que una misma
/// cuenta de restaurante administre mas de un establecimiento.
model Restaurant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName String  @map("business_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  locations   Location[]

  @@index([ownerId])
  @@map("restaurants")
}

/// Estado de la solicitud de operacion de una sede.
enum LocationStatus {
  pendiente_aprobacion
  activa
  rechazada

  @@map("location_status")
}

model Location {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  address         String
  latitude        Float?         @map("latitude")
  longitude       Float?         @map("longitude")
  logoUrl         String?        @map("logo_url")
  coverUrl        String?        @map("cover_url")
  status          LocationStatus @default(rechazada)
  rejectionReason String?        @map("rejection_reason")
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  schedules       LocationSchedule[]
  images          LocationImage[]
  staffMembers    User[]           @relation("LocationStaff")

  @@index([restaurantId])
  @@index([status])
  @@map("locations")
}

model LocationSchedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startsAt   String   @map("starts_at") @db.VarChar(5)
  endsAt     String   @map("ends_at") @db.VarChar(5)

  @@index([locationId, dayOfWeek])
  @@map("location_schedules")
}

model LocationImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  url        String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([locationId])
  @@map("location_images")
}

/// Refresh tokens vigentes. El logout marca revokedAt (GU-02 Esc. 5 y 6).
model Session {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 del refresh token. El valor en claro solo lo conoce el cliente.
  refreshTokenHash String               @unique @map("refresh_token_hash")

  issuedAt         DateTime             @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?            @map("last_used_at") @db.Timestamptz(6)

  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason    SessionRevokeReason? @map("revoked_reason")

  ipAddress        String?              @map("ip_address") @db.Inet
  userAgent        String?              @map("user_agent")

  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

/// Bitacora de intentos de inicio de sesion, base del bloqueo temporal
/// y de la auditoria de accesos (GU-02 Esc. 2 y 4).
model LoginAttempt {
  id              BigInt   @id @default(autoincrement())

  /// Se guarda aunque el correo no exista, para limitar por identificador
  /// sin revelar si esta registrado.
  emailAttempted  String   @map("email_attempted") @db.Citext
  userId          String?  @map("user_id") @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  successful      Boolean
  failureReason   String?  @map("failure_reason")

  ipAddress       String?  @map("ip_address") @db.Inet
  userAgent       String?  @map("user_agent")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([emailAttempted, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@map("login_attempts")
}
